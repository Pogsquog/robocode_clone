// Sweeper: orbits its radar, aims at whatever it finds, fires.
// Demonstrates: advanced tick style (set_* + await_tick), event polling.

func angdiff(a, b) {
    var d = (a - b) % 360;
    if (d > 180) { d = d - 360; }
    if (d <= -180) { d = d + 360; }
    return d;
}

func main() {
    set_radar_rate(45);
    set_body_rate(5);
    set_velocity(4);
    var aim = -1; // bearing of the last enemy seen (-1: none yet)
    while (true) {
        var e = pop_event();
        if (e == "scanned") {
            aim = event_bearing();
        }
        // The orbiting radar only sees the enemy now and then: keep the gun
        // on where it was last seen, firing whenever the gun is ready.
        if (aim >= 0 && energy() > 10) {
            fire_at(aim, 2);
        }
        await_tick();
    }
}
